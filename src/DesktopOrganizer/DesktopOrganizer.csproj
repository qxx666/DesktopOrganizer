<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 同时启用 WPF 与 WinForms 时，隐式 using 会引入 Button/Application 等类型歧义，
         这里显式关闭，所有命名空间在源文件中显式引用。 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 系统级 DPI 感知：整个会话只用一套缩放比例，
         保证窗口坐标和光标坐标的换算始终一致（拖动 / 吸附才不会偏）。 -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>

    <AssemblyName>DesktopOrganizer</AssemblyName>
    <RootNamespace>DesktopOrganizer</RootNamespace>
    <AssemblyTitle>桌面分区管家</AssemblyTitle>
    <Product>DesktopOrganizer</Product>
    <Version>1.1.2</Version>
    <FileVersion>1.1.2.0</FileVersion>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <Copyright>Copyright © 2026</Copyright>

    <!-- 图标由 tools/app-icon.b64.txt 还原而来；万一缺失也不阻断构建 -->
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- ===================== 常驻托盘应用的内存优化 =====================
       这个程序开机就一直挂在后台，内存占用比启动速度更重要，
       以下几项都是「牺牲一点点的通用性 / 停顿，换更低的常驻内存」。 -->

  <PropertyGroup>
    <!-- 这里曾经开过 InvariantGlobalization（省几十 MB 的 ICU 数据），但实测在真机上会让
         界面文本渲染直接崩掉：关掉区域性数据后 CultureInfo.CurrentUICulture 退化成「不变
         文化」，语言标记变成空字符串，而 WPF 的 FormattedText / TextBlock 排版依赖这个
         标记做字体回退与数字替换。编译时完全看不出来，只在运行时渲染文本时才炸。
         省下来的那点内存远不值得冒这个险，因此显式关掉，别再打开。 -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 后台（并发）GC 需要额外的工作集来做并发标记。托盘程序对 GC 停顿无感知，
         关掉它换更低的常驻内存。 -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- 工作站 GC（默认）+ 不保留虚拟内存：空闲内存及时还给系统，
         任务管理器里看到的占用会明显低一些。 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>

    <!-- 关掉动态 PGO 与热重载支持：减少 JIT 与运行时的常驻开销。 -->
    <TieredPGO>false</TieredPGO>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" Condition="Exists('Assets\app.ico')" />
  </ItemGroup>

</Project>
