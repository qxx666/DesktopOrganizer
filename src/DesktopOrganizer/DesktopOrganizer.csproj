<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 同时启用 WPF 与 WinForms 时，隐式 using 会引入 Button/Application 等类型歧义，
         这里显式关闭，所有命名空间在源文件中显式引用。 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 系统级 DPI 感知：整个会话只用一套缩放比例，
         保证窗口坐标和光标坐标的换算始终一致（拖动 / 吸附才不会偏）。 -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>

    <AssemblyName>DesktopOrganizer</AssemblyName>
    <RootNamespace>DesktopOrganizer</RootNamespace>
    <AssemblyTitle>桌面分区管家</AssemblyTitle>
    <Product>DesktopOrganizer</Product>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Copyright>Copyright © 2026</Copyright>

    <!-- 图标由 tools/app-icon.b64.txt 还原而来；万一缺失也不阻断构建 -->
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" Condition="Exists('Assets\app.ico')" />
  </ItemGroup>

</Project>
