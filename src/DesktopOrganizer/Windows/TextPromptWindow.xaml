<Window x:Class="DesktopOrganizer.Windows.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Border Background="#FA1B1E25"
            BorderBrush="#333A47"
            BorderThickness="1"
            CornerRadius="12"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <TextBlock x:Name="HeaderText"
                               Text="输入"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,4,20,0">
                <TextBlock x:Name="LabelText" Style="{StaticResource SectionTitle}" Text="名称" />
                <TextBox x:Name="PromptBox" Style="{StaticResource FieldTextBox}" MaxLength="120" TextChanged="PromptBox_TextChanged" />

                <CheckBox x:Name="OptionCheck"
                          Style="{StaticResource AppCheckBox}"
                          Margin="0,14,0,0"
                          Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,22,20,18">
                <Button Content="取消"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,10,0"
                        Click="Cancel_Click" />
                <Button x:Name="BtnConfirm"
                        Content="确定"
                        Style="{StaticResource PrimaryButton}"
                        Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
