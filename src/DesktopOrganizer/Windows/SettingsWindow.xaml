<Window x:Class="DesktopOrganizer.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="整理设置"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Border Background="#FA1B1E25"
            BorderBrush="#333A47"
            BorderThickness="1"
            CornerRadius="12"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <TextBlock Text="整理设置"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource HeaderCloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Cancel_Click">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="9" Height="9"
                              Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="0,2,0,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                </ScrollViewer.Resources>

                <StackPanel Margin="20,6,20,0">

                    <!-- ================= 存储位置 ================= -->
                    <TextBlock Text="存储位置" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RootFolderBox"
                                 Grid.Column="0"
                                 Style="{StaticResource FieldTextBox}" />
                        <Button Grid.Column="1"
                                Content="浏览…"
                                Style="{StaticResource GhostButton}"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Click="BrowseRoot_Click" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,7,0,0"
                               Text="新建分区时，会在这里按分区名创建一个子文件夹，拖进分区的文件就存放在里面。" />
                    <Button Content="打开这个目录"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Click="OpenRoot_Click" />

                    <!-- ================= 外观 ================= -->
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="0,22,0,9" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="图标大小" Style="{StaticResource FieldLabel}" Width="104" />
                        <StackPanel x:Name="IconSizeHost" Orientation="Horizontal" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="面板通透度" Style="{StaticResource FieldLabel}" Width="104" />
                        <StackPanel x:Name="OpacityHost" Orientation="Horizontal" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="界面主题" Style="{StaticResource FieldLabel}" Width="104" />
                        <StackPanel x:Name="ThemeHost" Orientation="Horizontal" />
                    </StackPanel>

                    <!-- ================= 行为 ================= -->
                    <TextBlock Text="行为" Style="{StaticResource SectionTitle}" Margin="0,22,0,9" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="显示 / 隐藏" Style="{StaticResource FieldLabel}" Width="104" />
                        <TextBox x:Name="HotkeyBox"
                                 Style="{StaticResource FieldTextBox}"
                                 Width="150"
                                 HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="例如 Ctrl+Alt+D" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="默认排序" Style="{StaticResource FieldLabel}" Width="104" />
                        <StackPanel x:Name="SortHost" Orientation="Horizontal" />
                    </StackPanel>

                    <CheckBox x:Name="StartupCheck"
                              Style="{StaticResource AppCheckBox}"
                              Margin="0,16,0,0"
                              Content="开机自动启动" />

                    <CheckBox x:Name="TopmostCheck"
                              Style="{StaticResource AppCheckBox}"
                              Margin="0,12,0,0"
                              Content="分区总在最前（不会被其它窗口挡住）" />

                    <CheckBox x:Name="SnapCheck"
                              Style="{StaticResource AppCheckBox}"
                              Margin="0,12,0,0"
                              Content="拖动分区时自动对齐到其它分区和屏幕边缘" />

                    <CheckBox x:Name="LockCheck"
                              Style="{StaticResource AppCheckBox}"
                              Margin="0,12,0,0"
                              Content="锁定布局（分区不能拖动、缩放和删除）" />

                    <CheckBox x:Name="HiddenCheck"
                              Style="{StaticResource AppCheckBox}"
                              Margin="0,12,0,8"
                              Content="显示隐藏文件和系统文件" />

                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Grid Grid.Row="2" Margin="20,20,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="配置目录"
                            Style="{StaticResource GhostButton}"
                            MinWidth="76"
                            Click="OpenConfigFolder_Click" />
                    <Button Content="恢复默认"
                            Style="{StaticResource GhostButton}"
                            MinWidth="76"
                            Margin="8,0,0,0"
                            Click="ResetDefaults_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click" />
                    <Button x:Name="BtnConfirm"
                            Content="保存"
                            Style="{StaticResource PrimaryButton}"
                            Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
